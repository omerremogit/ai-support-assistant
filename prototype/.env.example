# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-5-5

# anthropic = real model. fake = offline keyword model (no key needed, for checking the app runs).
LLM_PROVIDER=anthropic

# 1 = pilot (tiers A and B). 2 = Phase 2 (adds returns with agent approval).
PHASE=1

